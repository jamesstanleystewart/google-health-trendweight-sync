# Google OAuth credentials — reuse from your GCP project
# OAuth consent screen must have the Google Health API scope:
#   https://www.googleapis.com/auth/googlehealth.health_metrics_and_measurements.readonly
# Get a refresh token via https://developers.google.com/oauthplayground
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token

# TrendWeight API key — generate at trendweight.com → Settings → API Keys
TRENDWEIGHT_API_KEY=sk-your-key-here
